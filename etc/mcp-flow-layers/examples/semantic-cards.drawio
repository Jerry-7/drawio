        <mxCell id="lane-10" value="Core Method&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#5F6B7A;&quot;&gt;Main trace execution path&lt;/font&gt;" style="swimlane;html=1;startSize=40;rounded=0;shadow=0;horizontal=1;container=1;collapsible=0;whiteSpace=wrap;fontStyle=1;fontSize=14;strokeColor=#F58518;fillColor=#FFF2E5;fontColor=#1F1F1F;" parent="layer-9" vertex="1"><mxGeometry x="40" y="394" width="904" height="314" as="geometry" /></mxCell>
        <mxCell id="node-11" value="&lt;div style=&quot;margin:0;padding:0;&quot;&gt;&lt;div style=&quot;text-align:center;font-weight:700;font-size:14px;padding:10px 12px;background:#FFF2E5;border-bottom:2px solid #F58518;&quot;&gt;traceFeatureFlow(query, maxDepth)&lt;/div&gt;&lt;div style=&quot;padding:8px 10px;&quot;&gt;&lt;div style=&quot;font-size:11px;font-weight:700;color:#5F6B7A;text-transform:uppercase;margin-bottom:4px;&quot;&gt;Inputs&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-weight:600;&quot;&gt;query&lt;/span&gt;: User-entered feature or method name&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-weight:600;&quot;&gt;maxDepth&lt;/span&gt;: Maximum call-depth to traverse&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;padding:8px 10px;border-top:1px solid #D7DCE3;&quot;&gt;&lt;div style=&quot;font-size:11px;font-weight:700;color:#5F6B7A;text-transform:uppercase;margin-bottom:4px;&quot;&gt;Core Logic&lt;/div&gt;&lt;div&gt;&amp;#8226; Load the project index from .project-kg files&lt;/div&gt;&lt;div&gt;&amp;#8226; Resolve the most likely entry symbol from the query&lt;/div&gt;&lt;div&gt;&amp;#8226; Traverse downstream calls until maxDepth is reached&lt;/div&gt;&lt;div&gt;&amp;#8226; Format the trace for agent and human consumption&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;padding:8px 10px;border-top:1px solid #D7DCE3;&quot;&gt;&lt;div style=&quot;font-size:11px;font-weight:700;color:#5F6B7A;text-transform:uppercase;margin-bottom:4px;&quot;&gt;Outputs&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-weight:600;&quot;&gt;trace&lt;/span&gt;: Ordered call-chain result&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#F58518;fillColor=#FFFFFF;fontSize=13;fontColor=#1F1F1F;spacing=0;" parent="lane-10" vertex="1"><mxGeometry x="24" y="64" width="320" height="226" as="geometry" /></mxCell>
        <mxCell id="node-12" value="&lt;div style=&quot;text-align:center;&quot;&gt;&lt;div style=&quot;font-weight:700;font-size:14px;&quot;&gt;Symbol resolved?&lt;/div&gt;&lt;div style=&quot;margin-top:6px;&quot;&gt;Did query resolution produce a concrete method symbol?&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:11px;color:#666666;&quot;&gt;&amp;#8226; Yes: continue to call traversal&lt;br&gt;&amp;#8226; No: return a no-match result with explanation&lt;/div&gt;&lt;/div&gt;" style="rhombus;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#F58518;fillColor=#FFFFFF;fontSize=13;fontColor=#1F1F1F;spacing=10;" parent="lane-10" vertex="1"><mxGeometry x="372" y="64" width="220" height="120" as="geometry" /></mxCell>
