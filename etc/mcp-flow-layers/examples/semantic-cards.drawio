        <mxCell id="node-8" value="&lt;div style=&quot;margin:0;padding:0;&quot;&gt;&lt;div style=&quot;text-align:center;font-weight:700;font-size:14px;padding:10px 12px;background:#EAF2FB;border-bottom:2px solid #4C78A8;&quot;&gt;FeatureTraceService&lt;/div&gt;&lt;div style=&quot;padding:8px 10px;&quot;&gt;&lt;div style=&quot;font-size:11px;font-weight:700;color:#5F6B7A;text-transform:uppercase;margin-bottom:4px;&quot;&gt;Responsibility&lt;/div&gt;&lt;div&gt;Coordinates project-index lookup and bounded call-chain tracing.&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;padding:8px 10px;border-top:1px solid #D7DCE3;&quot;&gt;&lt;div style=&quot;font-size:11px;font-weight:700;color:#5F6B7A;text-transform:uppercase;margin-bottom:4px;&quot;&gt;Key Methods&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-weight:600;&quot;&gt;traceFeatureFlow(query, maxDepth)&lt;/span&gt;: Main user-facing entrypoint&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-weight:600;&quot;&gt;resolveEntrySymbol(query)&lt;/span&gt;: Maps the query to a concrete symbol&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#4C78A8;fillColor=#FFFFFF;fontSize=13;fontColor=#1F1F1F;spacing=0;" parent="lane-7" vertex="1"><mxGeometry x="24" y="64" width="320" height="170" as="geometry" /></mxCell>
