        <mxCell id="node-12" value="&lt;div style=&quot;margin:0;padding:0;&quot;&gt;&lt;div style=&quot;text-align:center;font-weight:700;font-size:14px;padding:10px 12px;background:#FFF2E5;border-bottom:2px solid #F58518;&quot;&gt;LayersFormatPanel&lt;/div&gt;&lt;div style=&quot;padding:8px 10px;&quot;&gt;&lt;div style=&quot;font-size:11px;font-weight:700;color:#5F6B7A;text-transform:uppercase;margin-bottom:4px;&quot;&gt;Responsibility&lt;/div&gt;&lt;div&gt;Right sidebar layers tab for quick layer management and state cycling.&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;padding:8px 10px;border-top:1px solid #D7DCE3;&quot;&gt;&lt;div style=&quot;font-size:11px;font-weight:700;color:#5F6B7A;text-transform:uppercase;margin-bottom:4px;&quot;&gt;Key Methods&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-weight:600;&quot;&gt;init()&lt;/span&gt;: Builds toolbar, focus controls, and layer list&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-weight:600;&quot;&gt;cycleState(layer)&lt;/span&gt;: Cycles visible -&amp;gt; dimmed -&amp;gt; hidden&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-weight:600;&quot;&gt;renameLayer(layer)&lt;/span&gt;: Prompt-based rename using text mode&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#F58518;fillColor=#FFFFFF;fontSize=13;fontColor=#1F1F1F;spacing=0;" parent="lane-11" vertex="1"><mxGeometry x="24" y="64" width="320" height="170" as="geometry" /></mxCell>
        <mxCell id="node-13" value="&lt;div style=&quot;margin:0;padding:0;&quot;&gt;&lt;div style=&quot;text-align:center;font-weight:700;font-size:14px;padding:10px 12px;background:#FFF2E5;border-bottom:2px solid #F58518;&quot;&gt;cycleState(layer)&lt;/div&gt;&lt;div style=&quot;padding:8px 10px;&quot;&gt;&lt;div style=&quot;font-size:11px;font-weight:700;color:#5F6B7A;text-transform:uppercase;margin-bottom:4px;&quot;&gt;Inputs&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-weight:600;&quot;&gt;layer&lt;/span&gt;: Target root child layer cell&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;padding:8px 10px;border-top:1px solid #D7DCE3;&quot;&gt;&lt;div style=&quot;font-size:11px;font-weight:700;color:#5F6B7A;text-transform:uppercase;margin-bottom:4px;&quot;&gt;Core Logic&lt;/div&gt;&lt;div&gt;&amp;#8226; If hidden, show the layer and clear manual dimming&lt;/div&gt;&lt;div&gt;&amp;#8226; If visible and dimmed, clear dimming then hide the layer&lt;/div&gt;&lt;div&gt;&amp;#8226; If visible and normal, keep visible and enable manual dimming&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;padding:8px 10px;border-top:1px solid #D7DCE3;&quot;&gt;&lt;div style=&quot;font-size:11px;font-weight:700;color:#5F6B7A;text-transform:uppercase;margin-bottom:4px;&quot;&gt;Outputs&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-weight:600;&quot;&gt;layer state&lt;/span&gt;: Updated display state in model + temporary opacity flags&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#F58518;fillColor=#FFFFFF;fontSize=13;fontColor=#1F1F1F;spacing=0;" parent="lane-11" vertex="1"><mxGeometry x="372" y="64" width="320" height="190" as="geometry" /></mxCell>
