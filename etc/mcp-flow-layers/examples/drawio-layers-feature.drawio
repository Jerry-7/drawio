        <mxCell id="node-9" value="&lt;div style=&quot;margin:0;padding:0;&quot;&gt;&lt;div style=&quot;text-align:center;font-weight:700;font-size:14px;padding:10px 12px;background:#EAF2FB;border-bottom:2px solid #4C78A8;&quot;&gt;Graph.createLayersDialog(onchange, inverted)&lt;/div&gt;&lt;div style=&quot;padding:8px 10px;&quot;&gt;&lt;div style=&quot;font-size:11px;font-weight:700;color:#5F6B7A;text-transform:uppercase;margin-bottom:4px;&quot;&gt;Inputs&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-weight:600;&quot;&gt;onchange&lt;/span&gt;: Refresh callback after layer interaction&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-weight:600;&quot;&gt;inverted&lt;/span&gt;: Use inverted icon treatment for chromeless UI&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;padding:8px 10px;border-top:1px solid #D7DCE3;&quot;&gt;&lt;div style=&quot;font-size:11px;font-weight:700;color:#5F6B7A;text-transform:uppercase;margin-bottom:4px;&quot;&gt;Core Logic&lt;/div&gt;&lt;div&gt;&amp;#8226; Build a lightweight layer popup for chromeless or embed UI&lt;/div&gt;&lt;div&gt;&amp;#8226; Create focus toggle and opacity slider&lt;/div&gt;&lt;div&gt;&amp;#8226; Render per-layer visibility and dim controls&lt;/div&gt;&lt;div&gt;&amp;#8226; Call onchange after visibility changes&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;padding:8px 10px;border-top:1px solid #D7DCE3;&quot;&gt;&lt;div style=&quot;font-size:11px;font-weight:700;color:#5F6B7A;text-transform:uppercase;margin-bottom:4px;&quot;&gt;Outputs&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-weight:600;&quot;&gt;div&lt;/span&gt;: DOM container for the lightweight layers popup&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#4C78A8;fillColor=#FFFFFF;fontSize=13;fontColor=#1F1F1F;spacing=0;" parent="lane-7" vertex="1"><mxGeometry x="372" y="64" width="320" height="226" as="geometry" /></mxCell>
