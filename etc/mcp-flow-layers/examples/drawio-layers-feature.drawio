        <mxCell id="node-21" value="&lt;div style=&quot;margin:0;padding:0;&quot;&gt;&lt;div style=&quot;text-align:center;font-weight:700;font-size:14px;padding:10px 12px;background:#FDECEC;border-bottom:2px solid #E45756;&quot;&gt;Graph.applyLayerOpacity()&lt;/div&gt;&lt;div style=&quot;padding:8px 10px;&quot;&gt;&lt;div style=&quot;font-size:11px;font-weight:700;color:#5F6B7A;text-transform:uppercase;margin-bottom:4px;&quot;&gt;Inputs&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-weight:600;&quot;&gt;layerOpacityValue&lt;/span&gt;: Configured dim opacity percent&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-weight:600;&quot;&gt;defaultParent&lt;/span&gt;: Current active layer&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;padding:8px 10px;border-top:1px solid #D7DCE3;&quot;&gt;&lt;div style=&quot;font-size:11px;font-weight:700;color:#5F6B7A;text-transform:uppercase;margin-bottom:4px;&quot;&gt;Core Logic&lt;/div&gt;&lt;div&gt;&amp;#8226; Walk root-level layers and skip null roots&lt;/div&gt;&lt;div&gt;&amp;#8226; Decide per-layer opacity using visible state, manual dim flag, and focus mode&lt;/div&gt;&lt;div&gt;&amp;#8226; Traverse rendered descendant states and patch shape/text DOM opacity only&lt;/div&gt;&lt;div&gt;&amp;#8226; Clean stale layer ids from manual opacity storage&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;padding:8px 10px;border-top:1px solid #D7DCE3;&quot;&gt;&lt;div style=&quot;font-size:11px;font-weight:700;color:#5F6B7A;text-transform:uppercase;margin-bottom:4px;&quot;&gt;Outputs&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-weight:600;&quot;&gt;rendered opacity&lt;/span&gt;: Temporary view-only opacity applied to DOM nodes&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#E45756;fillColor=#FFFFFF;fontSize=13;fontColor=#1F1F1F;spacing=0;" parent="lane-20" vertex="1"><mxGeometry x="24" y="64" width="320" height="226" as="geometry" /></mxCell>
        <mxCell id="node-22" value="&lt;div style=&quot;text-align:center;&quot;&gt;&lt;div style=&quot;font-weight:700;font-size:14px;&quot;&gt;Should this layer be dimmed?&lt;/div&gt;&lt;div style=&quot;margin-top:6px;&quot;&gt;Layer is visible and either manually dimmed or excluded from current focus set&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:11px;color:#666666;&quot;&gt;&amp;#8226; Yes: apply configured opacity percent&lt;br&gt;&amp;#8226; No: restore original opacity&lt;/div&gt;&lt;/div&gt;" style="rhombus;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#E45756;fillColor=#FFFFFF;fontSize=13;fontColor=#1F1F1F;spacing=10;" parent="lane-20" vertex="1"><mxGeometry x="372" y="64" width="220" height="120" as="geometry" /></mxCell>
